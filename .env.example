# On a public HTTPS deployment, configure these server-side; never use VITE_ for secrets.
META_APP_ID=
META_APP_SECRET=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable and secret; do not use a VITE_ prefix or commit the key.
STUDIO_TOKEN_KEY=
PUBLIC_BASE_URL=
META_GRAPH_VERSION=v23.0
PORT=3000
