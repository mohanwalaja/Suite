# ─────────────────────────────────────────────────────────────────────────────
# Astro Sivam Creative Studio — environment example
#
# Copy to `.env` and fill in only what you use. EVERYTHING HERE IS OPTIONAL.
# With no .env at all the studio runs fully: artwork is drawn by the local
# vector engine, fonts are bundled, and projects are saved in the browser.
#
# Never put a paid provider secret in a VITE_ variable. VITE_ values are
# compiled into the public bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional AI image provider (bring your own, server-side) ─────────────────
# Leave empty to keep the "AI" artwork mode disabled. When set, the editor calls
# your proxy instead of a provider directly. The proxy in public/api/generate.php
# is a ready implementation: it holds the key and returns
#   { "image": "data:image/png;base64,..." }   or   { "url": "https://..." }
#
# VITE_AI_ENDPOINT=/api/generate.php
# VITE_AI_PROVIDER_NAME=Studio image proxy

# ── Optional cloud project storage (PHP + MySQL) ─────────────────────────────
# Leave empty for browser-only storage. Point at the folder that contains
# auth.php and projects.php. Must be HTTPS in production.
#
# VITE_API_BASE=https://studio.astrosivam.com/api

# ── Server-side variables (set in hosting panel, never commit real values) ───
# These are read by public/api/config.php.
#
# DB_DSN=mysql:host=localhost;dbname=astrosivam_studio;charset=utf8mb4
# DB_USER=astrosivam_studio
# DB_PASS=change-me
# APP_ORIGIN=https://studio.astrosivam.com
# SESSION_NAME=astrosivam_studio
#
# AI_PROVIDER=none            # none | openai | stability
# AI_API_KEY=
# AI_MODEL=gpt-image-1
# AI_PROXY_TOKEN=             # optional shared token for generate.php

# ── Optional build metadata ──────────────────────────────────────────────────
# VITE_SITE_URL=https://astrosivam.com
