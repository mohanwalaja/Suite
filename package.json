{
  "name": "astrosivam-creative-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Astrosivam Creative Studio \u2014 composition-based poster and motion-graphics studio for astrology and devotional brands.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
    "samples": "tsx scripts/render-samples.mts",
    "test": "tsx scripts/test-engine.mts",
    "verify": "npm run typecheck && npm run test && npm run samples",
    "lint:engine": "tsx scripts/test-engine.mts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "wawoff2": "^2.0.1"
  }
}
