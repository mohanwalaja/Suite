# Never serve configuration or SQL over HTTP.
<FilesMatch "^(config\.php|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>

# JSON endpoints only; no directory indexes.
Options -Indexes

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
